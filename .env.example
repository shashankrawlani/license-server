# Admin API key for protecting sensitive endpoints (REQUIRED)
ADMIN_API_KEY=your-admin-key-here

# Multi-Tenant Mode (default: False for sidecar deployment)
# Set to True for central multi-app server with full isolation
MULTI_TENANT_MODE=False

# Resend Configuration (OPTIONAL - required for email functionality)
RESEND_API_KEY=
RESEND_FROM_EMAIL=license-server@automationtester.in

# Base URL (REQUIRED for verification links)
BASE_URL=http://localhost:8321

# Database Configuration
# PostgreSQL (recommended for production):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/license_server
# SQLite (good for development/testing):
# DATABASE_URL=sqlite:///data/licenses.db

# Key Material Paths
PRIVATE_KEY_PATH=data/private.pem
PUBLIC_KEY_PATH=data/public.pem

# Security Features
RATE_LIMIT_ENABLED=true

# Environment (dev, staging, production)
# Set to "dev" to enable /docs and /redoc
ENVIRONMENT=production
